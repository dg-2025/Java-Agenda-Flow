<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- RF-07 a RF-11: agendar em 4 passos (RNF-04: no máximo 5) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.fatec.agendaflow.controller.ClienteAgendarController"
      styleClass="vidro" spacing="18">
    <padding><Insets top="26" right="30" bottom="22" left="30"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="titulo" text="Novo agendamento" styleClass="titulo-grande"/>
            <Label fx:id="subtitulo" styleClass="texto-suave"/>
        </VBox>
        <Button fx:id="botaoVoltar" text="Voltar" onAction="#voltar"/>
    </HBox>

    <HBox fx:id="etapas" alignment="CENTER_LEFT" spacing="12"/>
    <Region styleClass="separador"/>

    <ScrollPane fx:id="rolagem" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox fx:id="corpo" spacing="16">
            <padding><Insets top="4" right="6" bottom="12" left="2"/></padding>
        </VBox>
    </ScrollPane>
</VBox>
