<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- RF-03: cadastrar, editar e ativar/inativar serviços -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.fatec.agendaflow.controller.AdminServicosController"
      styleClass="vidro" spacing="16">
    <padding><Insets top="26" right="28" bottom="20" left="28"/></padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Serviços" styleClass="titulo-grande"/>
            <Label text="O que o salão oferece. Serviço inativo some da tela do cliente." styleClass="texto-suave"/>
        </VBox>
        <Button fx:id="botaoNovo" text="Novo serviço" styleClass="botao-primario" onAction="#novo"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabela" HBox.hgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNome" text="SERVIÇO" prefWidth="200"/>
                <TableColumn fx:id="colDuracao" text="DURAÇÃO" prefWidth="100"/>
                <TableColumn fx:id="colValor" text="VALOR" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="110"/>
            </columns>
        </TableView>

        <VBox fx:id="formulario" styleClass="vidro-leve" spacing="12" prefWidth="320" minWidth="300" maxWidth="340">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label fx:id="tituloFormulario" text="Novo serviço" styleClass="titulo"/>
            <VBox spacing="6">
                <Label text="Nome" styleClass="rotulo"/>
                <TextField fx:id="campoNome" promptText="Ex.: Corte feminino"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Descrição" styleClass="rotulo"/>
                <TextField fx:id="campoDescricao" promptText="Opcional"/>
            </VBox>
            <HBox spacing="10">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Duração (min)" styleClass="rotulo"/>
                    <TextField fx:id="campoDuracao" promptText="60"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Valor (R$)" styleClass="rotulo"/>
                    <TextField fx:id="campoValor" promptText="90,00"/>
                </VBox>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Situação" styleClass="rotulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ToggleButton fx:id="campoAtivo" text="Ativo" styleClass="interruptor" selected="true"/>
            </HBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="botaoSalvar" text="Salvar serviço" styleClass="botao-primario" maxWidth="Infinity" onAction="#salvar"/>
        </VBox>
    </HBox>
</VBox>
